# Copy to .env.local and fill in (Supabase → Project Settings → API Keys).
# On Vercel: Project → Settings → Environment Variables.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only — never prefix with NEXT_PUBLIC_. Lets the Byl webhook mark pre-orders paid.
SUPABASE_SERVICE_ROLE_KEY=

# Byl online deposit (https://byl.mn/docs/api). Project → Тохиргоо → API токен; Webhooks → Signing secret.
# Register the webhook URL WITH the trailing slash: https://<domain>/api/byl/webhook/
# Without these the pre-order form works as before, without online payment.
BYL_PROJECT_ID=
BYL_TOKEN=
BYL_WEBHOOK_SECRET=
