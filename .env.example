# Copy to .env.local and fill in (Supabase → Project Settings → API Keys).
# On Vercel: Project → Settings → Environment Variables.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only — never prefix with NEXT_PUBLIC_. Lets the Byl webhook mark pre-orders paid.
SUPABASE_SERVICE_ROLE_KEY=

# Byl online deposit (https://byl.mn/docs/api). Project → Тохиргоо → API токен; Webhooks → Signing secret.
# Register the webhook URL WITH the trailing slash: https://<domain>/api/byl/webhook/
# Without these the pre-order form works as before, without online payment.
BYL_PROJECT_ID=
BYL_TOKEN=
BYL_WEBHOOK_SECRET=

# «AI туслах» (user test #1): ChatGPT on this site's data. Without a key every question goes to /admin/assistant/.
OPENAI_API_KEY=
# Optional, default gpt-4o-mini.
OPENAI_MODEL=

# Prize voucher after a pre-order (user test #1): n8n webhook that e-mails the voucher. Empty = test mode
# (voucher shown on screen only). Payload: docs/n8n-voucher.md
N8N_VOUCHER_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Secret for the voucher codes (any long random text). Falls back to the service role key.
VOUCHER_SECRET=
# Facebook Page username for the «Messenger-ээр авах» button (m.me/<page>?ref=voucher_<code>).
NEXT_PUBLIC_FACEBOOK_PAGE=
